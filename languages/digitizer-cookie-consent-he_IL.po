#: includes/class-digitizer-cookie-consent-admin.php:1332
msgid "Marketing scripts"
msgstr "סקריפטים של שיווק"

#: includes/class-digitizer-cookie-consent-admin.php:1337
msgid "For example: Facebook Pixel, Google Ads, TikTok Pixel, LinkedIn Insight."
msgstr "לדוגמה: Facebook Pixel, Google Ads, TikTok Pixel, LinkedIn Insight."

#: includes/class-digitizer-cookie-consent-admin.php:1346
msgid "Floating \"Manage Cookies\" Button"
msgstr "כפתור ניהול עוגיות צף"

#: includes/class-digitizer-cookie-consent-admin.php:1347
msgid "A small button in the corner of the site that lets visitors reopen the banner and change their preferences at any time. Its text and accessibility label are edited per language on the \"Texts\" tab."
msgstr "כפתור קטן בפינת האתר שמאפשר למבקרים לפתוח את הבאנר מחדש ולשנות העדפות בכל עת. הטקסט ותווית הנגישות שלו נערכים לפי שפה בטאב \"טקסטים\"."

#: includes/class-digitizer-cookie-consent-admin.php:1349
msgid "Basics"
msgstr "הגדרות בסיס"

#: includes/class-digitizer-cookie-consent-admin.php:1352
msgid "Enable button"
msgstr "הפעלת הכפתור"

#: includes/class-digitizer-cookie-consent-admin.php:1356
msgid "Anchor corner"
msgstr "פינת עוגן"

#: includes/class-digitizer-cookie-consent-admin.php:1362
msgid "Top-right corner"
msgstr "פינה ימנית עליונה"

#: includes/class-digitizer-cookie-consent-admin.php:1363
msgid "Top-left corner"
msgstr "פינה שמאלית עליונה"

#: includes/class-digitizer-cookie-consent-admin.php:1371
msgid "The final position is the corner plus the offsets below."
msgstr "המיקום הסופי הוא הפינה ועוד המרחקים שבהמשך."

#: includes/class-digitizer-cookie-consent-admin.php:1384
msgid "Desktop position"
msgstr "מיקום במחשב"

#: includes/class-digitizer-cookie-consent-admin.php:1385
msgid "Offsets are measured from the chosen corner. For example, corner \"bottom-right\" with vertical offset 100 places the button 100px above the bottom - handy for avoiding WhatsApp/chat buttons."
msgstr "המרחקים נמדדים מהפינה שנבחרה. לדוגמה: פינה ימנית תחתונה עם מרחק אנכי 100 ממקמת את הכפתור 100 פיקסלים מעל התחתית - שימושי כדי לא להתנגש בכפתורי WhatsApp/צ'אט."

#: includes/class-digitizer-cookie-consent-admin.php:1388 includes/class-digitizer-cookie-consent-admin.php:1408
msgid "Horizontal offset"
msgstr "מרחק אופקי"

#: includes/class-digitizer-cookie-consent-admin.php:1392 includes/class-digitizer-cookie-consent-admin.php:1412
msgid "Vertical offset"
msgstr "מרחק אנכי"

#: includes/class-digitizer-cookie-consent-admin.php:1395
msgid "Tip: WhatsApp buttons usually sit 20-80px from the bottom. Use 90-100 to avoid collisions."
msgstr "טיפ: כפתורי WhatsApp יושבים בדרך כלל 20-80 פיקסלים מהתחתית. השתמשו ב-90-100 כדי להימנע מהתנגשות."

#: includes/class-digitizer-cookie-consent-admin.php:1399 includes/class-digitizer-cookie-consent-admin.php:1416
msgid "Button size"
msgstr "גודל הכפתור"

#: includes/class-digitizer-cookie-consent-admin.php:1404
msgid "Mobile position"
msgstr "מיקום במובייל"

#: includes/class-digitizer-cookie-consent-admin.php:1405
msgid "Separate values for screens up to 640px wide."
msgstr "ערכים נפרדים למסכים ברוחב עד 640 פיקסלים."

#: includes/class-digitizer-cookie-consent-admin.php:1500
msgid "Preview"
msgstr "תצוגה מקדימה"

#: includes/class-digitizer-cookie-consent-admin.php:1501
msgid "Updates after saving."
msgstr "מתעדכן לאחר שמירה."

#: includes/class-digitizer-cookie-consent-admin.php:1529
msgid "View banner on the site"
msgstr "צפייה בבאנר באתר"

#: includes/class-digitizer-cookie-consent-frontend.php:1208
msgid "Cookie consent by Digitizer"
msgstr "הסכמה לעוגיות מבית דיגיטייזר"

#. Plugin Name of the plugin
#: digitizer-cookie-consent.php
msgid "Digitizer Cookie Consent"
msgstr "Digitizer Cookie Consent"

#. Description of the plugin
#: digitizer-cookie-consent.php
msgid "A cookie consent banner for Hebrew and multilingual sites: categories, scripts blocked until consent, Google Consent Mode v2, the WP Consent API, and the cookies of a refused category deleted. Nothing is sent anywhere."
msgstr "באנר הסכמה לעוגיות לאתרים בעברית ובכמה שפות: קטגוריות, סקריפטים שנחסמים עד להסכמה, Google Consent Mode v2, ה-WP Consent API, ומחיקת העוגיות של קטגוריה שסורבה. שום מידע לא נשלח לשום מקום."
