msgstr "קישור שפותח את הבאנר מחדש"

#: includes/class-digitizer-cookie-consent-admin.php:650
msgid "Any link to #dpt-cookie-settings, or any element with the class dpt-cb-open, opens the banner so a visitor can change their choice - for example a footer link instead of the floating button. The shortcode prints such a link; text=\"...\" sets its wording."
msgstr "כל קישור ל-#dpt-cookie-settings, או כל אלמנט עם המחלקה dpt-cb-open, פותח את הבאנר כדי שמבקר יוכל לשנות את הבחירה שלו - למשל קישור בפוטר במקום הכפתור הצף. השורטקוד מדפיס קישור כזה; text=\"...\" קובע את הנוסח שלו."

#: includes/class-digitizer-cookie-consent-admin.php:654
msgid "Default language"
msgstr "שפת ברירת מחדל"

#: includes/class-digitizer-cookie-consent-admin.php:661
msgid "Used when the page locale has no matching language."
msgstr "בשימוש כששפת העמוד לא תואמת לאף שפה מוגדרת."

#: includes/class-digitizer-cookie-consent-admin.php:674
msgid "Manage languages"
msgstr "ניהול שפות"

#: includes/class-digitizer-cookie-consent-admin.php:679
msgid "Add language (code):"
msgstr "הוספת שפה (קוד):"

#: includes/class-digitizer-cookie-consent-admin.php:681
msgid "Add"
msgstr "הוסף"

#: includes/class-digitizer-cookie-consent-admin.php:686
msgid "Remove this language and its texts?"
msgstr "להסיר את השפה ואת הטקסטים שלה?"

#. translators: %s: language label
#: includes/class-digitizer-cookie-consent-admin.php:693
msgid "Remove \"%s\""
msgstr "הסרת \"%s\""

#: includes/class-digitizer-cookie-consent-admin.php:699
msgid "New languages start with the English texts. The default language cannot be removed."
msgstr "שפות חדשות מתחילות עם הטקסטים באנגלית. לא ניתן להסיר את שפת ברירת המחדל."

#: includes/class-digitizer-cookie-consent-admin.php:706
msgid "Banner Design"
msgstr "עיצוב הבאנר"

#: includes/class-digitizer-cookie-consent-admin.php:711
msgid "Inherit from the site (recommended)"
msgstr "ירושה מהאתר (מומלץ)"

#: includes/class-digitizer-cookie-consent-admin.php:712
msgid "Elementor primary font"
msgstr "הפונט הראשי של אלמנטור"

#: includes/class-digitizer-cookie-consent-admin.php:713 includes/class-digitizer-cookie-consent-admin.php:745
msgid "Custom font stack"
msgstr "פונט מותאם אישית"

#: includes/class-digitizer-cookie-consent-admin.php:716
msgid "Font"
msgstr "פונט"

#: includes/class-digitizer-cookie-consent-admin.php:719
msgid "Font family"
msgstr "משפחת פונט"

#: includes/class-digitizer-cookie-consent-admin.php:727
msgid "By default the banner inherits the font of the page, so it matches your theme automatically. Pick Elementor to follow its primary global font explicitly, or set your own stack below."
msgstr "כברירת מחדל הבאנר יורש את הפונט של העמוד, כך שהוא מתאים לתבנית שלכם אוטומטית. בחרו באלמנטור כדי לעקוב במפורש אחרי הפונט הגלובלי הראשי שלו, או הגדירו פונט משלכם למטה."

#. translators: %s: font family name detected from Elementor
#: includes/class-digitizer-cookie-consent-admin.php:734
msgid "Elementor primary font detected: %s"
msgstr "זוהה פונט ראשי של אלמנטור: %s"

#: includes/class-digitizer-cookie-consent-admin.php:740
msgid "No Elementor primary font detected on this site - that option will fall back to inheriting."
msgstr "לא זוהה פונט ראשי של אלמנטור באתר זה - אפשרות זו תחזור לירושה מהאתר."

#: includes/class-digitizer-cookie-consent-admin.php:748
msgid "Used only when \"Custom font stack\" is selected. The font itself must already be loaded by the theme - this setting does not load web fonts."
msgstr "בשימוש רק כאשר נבחר \"פונט מותאם אישית\". הפונט עצמו חייב להיות כבר נטען על ידי התבנית - הגדרה זו אינה טוענת פונטים."

#: includes/class-digitizer-cookie-consent-admin.php:753
msgid "Colors and background"
msgstr "צבעים ורקע"

#: includes/class-digitizer-cookie-consent-admin.php:756 includes/class-digitizer-cookie-consent-admin.php:1222 includes/class-digitizer-cookie-consent-admin.php:1375
msgid "Background color"
msgstr "צבע רקע"

#: includes/class-digitizer-cookie-consent-admin.php:760
